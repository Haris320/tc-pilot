# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ClickHouse Cloud
CLICKHOUSE_HOST=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=tc_copilot

# Nimble
NIMBLE_API_KEY=

# Datadog — DD_SITE must match the region where your API key was created
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=tc-copilot
DD_ENV=development
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=tc-copilot
# Required for local dev without a Datadog Agent container on :8126
DD_LLMOBS_AGENTLESS_ENABLED=1

# CORS
FRONTEND_ORIGIN=http://localhost:3000
